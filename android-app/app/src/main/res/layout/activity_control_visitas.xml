<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FEFCF8">

    <TextView
        android:id="@+id/txt_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Control de visitas"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/txt_contador_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total de visitas registradas:"
        android:textSize="16sp"
        android:textColor="#666666" />

    <TextView
        android:id="@+id/txt_visitas_resultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#2E7D52"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btn_registrar_visita"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Registrar visita"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#2E7D52"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_consultar_visitas"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Consultar visitas"
        android:textAllCaps="false"
        android:textSize="16sp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="#2E7D52" />

</LinearLayout>