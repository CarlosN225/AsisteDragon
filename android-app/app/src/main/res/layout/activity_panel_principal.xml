<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2EDE6">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_primary"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Foto de perfil en header -->
            <ImageView
                android:id="@+id/header_foto_perfil"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:src="@android:drawable/ic_menu_gallery"
                android:scaleType="centerCrop"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Ver perfil"/>

            <!-- Datos del usuario -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/header_foto_perfil"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bienvenido"
                    android:textSize="12sp"
                    android:textColor="#AAFFFFFF"
                    android:letterSpacing="0.06"/>

                <TextView
                    android:id="@+id/texto_nombre_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carlos ND"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="1dp"/>

                <TextView
                    android:id="@+id/texto_tipo_turno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asignatura • Matutino"
                    android:textSize="12sp"
                    android:textColor="#BBFFFFFF"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/boton_cerrar_sesion"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:padding="9dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar Sesión"
                app:tint="#CCFFFFFF"/>
        </RelativeLayout>
    </LinearLayout>

    <!-- ── SWIPE REFRESH + SCROLL ─────────────────────────────────────── -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@+id/bottom_navigation">

        <ScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <!-- CARD ASISTENCIA — sin registrar -->
                <RelativeLayout
                    android:id="@+id/estado_sin_registrar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="48dp"
                        android:paddingBottom="40dp"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp">

                        <TextView
                            android:id="@+id/texto_fecha_hoy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jueves, 19 de marzo"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1C1C1C"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:id="@+id/texto_aun_no_registrado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aún no has registrado tu asistencia"
                            android:textSize="13sp"
                            android:textColor="#AAAAAA"
                            android:layout_marginBottom="36dp"/>

                        <ImageView
                            android:id="@+id/boton_registrar_asistencia"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:src="@android:drawable/ic_menu_camera"
                            android:background="@drawable/fondo_boton_circular"
                            android:padding="22dp"
                            android:contentDescription="Registrar Asistencia"
                            android:elevation="4dp"
                            app:tint="@color/white"/>

                        <TextView
                            android:id="@+id/texto_escanea_qr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Escanea el QR para iniciar tu día"
                            android:textSize="12sp"
                            android:textColor="#BBBBBB"
                            android:layout_marginTop="16dp"/>

                        <TextView
                            android:id="@+id/texto_sin_asistencia_hoy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="13sp"
                            android:textColor="#AAAAAA"
                            android:gravity="center"
                            android:layout_marginTop="10dp"
                            android:visibility="gone"/>
                    </LinearLayout>
                </RelativeLayout>

                <!-- CARD ASISTENCIA — registrado -->
                <RelativeLayout
                    android:id="@+id/estado_registrado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="36dp"
                        android:paddingBottom="28dp"
                        android:paddingStart="28dp"
                        android:paddingEnd="28dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="20dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ASISTENCIA REGISTRADA"
                                    android:textSize="9sp"
                                    android:textColor="#AAAAAA"
                                    android:letterSpacing="0.1"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:id="@+id/texto_fecha_registro"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textColor="#444444"
                                    android:textStyle="bold"
                                    android:layout_marginTop="2dp"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/texto_estado_asistencia"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PUNTUAL"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/success"
                                android:background="@drawable/badge_puntual"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E8E2D9"
                            android:layout_marginBottom="24dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HORA DE REGISTRO"
                            android:textSize="9sp"
                            android:textColor="#BBBBBB"
                            android:letterSpacing="0.12"
                            android:gravity="center"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/texto_hora_registro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15:58:31"
                            android:textSize="52sp"
                            android:textStyle="bold"
                            android:textColor="#1C1C1C"
                            android:letterSpacing="-0.02"
                            android:gravity="center"/>

                        <LinearLayout
                            android:id="@+id/texto_mensaje_retardo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="#FFF8F0"
                            android:padding="14dp"
                            android:layout_marginTop="20dp"
                            android:visibility="gone">

                            <View
                                android:layout_width="3dp"
                                android:layout_height="match_parent"
                                android:background="#E6A04A"
                                android:layout_marginEnd="12dp"/>

                            <TextView
                                android:id="@+id/texto_retardo_contenido"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:textColor="#7A5520"
                                android:lineSpacingExtra="3dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>

                <!-- SEPARADOR -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E4DDD4"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"/>

                <!-- BANNER HORARIO + CHECKLIST -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_horario_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="18dp"
                    android:visibility="gone"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FEFCF8">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/banner_estado_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="EN CLASE AHORA"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#1C1C1C"
                                android:letterSpacing="0.1"/>

                            <LinearLayout
                                android:id="@+id/banner_contador_layout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="#0A000000"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/banner_tiempo_restante"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="45 min restantes"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="#1C1C1C"/>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/banner_materia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sistemas Operativos"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:textColor="#1C1C1C"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/banner_grupo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DSM 204"
                            android:textSize="13sp"
                            android:textColor="#1C1C1C"
                            android:layout_marginBottom="16dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#0A000000"
                            android:layout_marginBottom="16dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="HORARIO"
                                    android:textSize="9sp"
                                    android:textColor="#888888"
                                    android:letterSpacing="0.1"/>

                                <TextView
                                    android:id="@+id/banner_horario"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="16:00 – 18:00"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#1C1C1C"
                                    android:layout_marginTop="3dp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AULA"
                                    android:textSize="9sp"
                                    android:textColor="#888888"
                                    android:letterSpacing="0.1"/>

                                <TextView
                                    android:id="@+id/banner_aula"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="D-105"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#1C1C1C"
                                    android:layout_marginTop="3dp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btn_expand_checklist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ver todas las clases de hoy ▾"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#555555"
                            android:gravity="center"
                            android:paddingTop="9dp"
                            android:paddingBottom="9dp"
                            android:background="#0A000000"/>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_checklist_wrapper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:visibility="gone"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FEFCF8">

                            <LinearLayout
                                android:id="@+id/checklist_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"/>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- BOTÓN TERMINAR MI DÍA -->
                <LinearLayout
                    android:id="@+id/layout_terminar_dia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E4DDD4"
                        android:layout_marginBottom="18dp"/>

                    <Button
                        android:id="@+id/boton_terminar_dia"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Terminar mi día"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#666666"
                        android:backgroundTint="#EDE8DF"
                        app:cornerRadius="16dp"
                        android:letterSpacing="0.02"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- PANTALLA DÍA COMPLETADO -->
    <RelativeLayout
        android:id="@+id/pantalla_dia_completado"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@+id/bottom_navigation"
        android:background="#F2EDE6"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="36dp"
            android:paddingEnd="36dp">

            <RelativeLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="28dp">

                <View
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/circulo_exito_fondo"/>

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_centerInParent="true"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="@color/white"
                    android:contentDescription="Día completado"/>
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Ha terminado su día!"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1C1C1C"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gracias por asistir y seguir formando buenos jóvenes universitarios. ¡Nos vemos en la próxima sesión!"
                android:textSize="15sp"
                android:textColor="#888888"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="32dp"/>

            <View
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:background="@color/green_primary"
                android:layout_marginBottom="28dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#EAF4EE"
                android:padding="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@color/green_primary"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="QR"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No olvide pasar asistencia al llegar al edificio mañana"
                    android:textSize="12sp"
                    android:textColor="#2E7D52"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- BOTTOM NAV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FEFCF8"
        android:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu"/>

</RelativeLayout>