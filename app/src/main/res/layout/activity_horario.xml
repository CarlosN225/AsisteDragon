<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0EA">

    <!-- ── HEADER ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/green_primary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mi Horario"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.02"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Universidad Tecnológica Fidel Velázquez"
            android:textSize="11sp"
            android:textColor="#BBFFD6"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- ── SCROLL PRINCIPAL ───────────────────────────────────────────── -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@+id/bottom_navigation"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingBottom="24dp">

            <!-- ── SIN HORARIO ─────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/card_sin_horario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="60dp"
                android:paddingBottom="40dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="@color/green_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin horario cargado"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sube tu horario para visualizarlo
y editarlo desde aquí"
                    android:textSize="13sp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="40dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="24dp">

                        <Button
                            android:id="@+id/btnSubirPDF"
                            android:layout_width="85dp"
                            android:layout_height="72dp"
                            android:backgroundTint="@color/green_primary"
                            android:elevation="4dp"
                            android:text="PDF"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="36dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Documento"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnSubirImagen"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="85dp"
                            android:layout_height="72dp"
                            android:backgroundTint="#E8F5E9"
                            android:elevation="2dp"
                            android:text="IMG"
                            android:textColor="@color/green_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="36dp"
                            app:strokeColor="@color/green_primary"
                            app:strokeWidth="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Imagen"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- ── PROCESANDO ──────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/card_procesando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="80dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="28dp">
                    <View
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="#E8F5E9"/>
                    <ProgressBar
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/green_primary"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analizando horario"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/texto_estado_ocr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Procesando con IA..."
                    android:textSize="13sp"
                    android:textColor="#AAAAAA"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp"/>

            </LinearLayout>

            <!-- ── CARD: PERIODO Y VIGENCIA (NUEVO) ───────────────────── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_periodo_vigencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FEFCF8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informacion del Periodo"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"
                        android:layout_marginBottom="14dp"/>

                    <!-- Vigencia -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vigencia:  "
                            android:textSize="12sp"
                            android:textColor="#999999"/>

                        <TextView
                            android:id="@+id/txt_vigencia"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No detectada en el PDF"
                            android:textSize="12sp"
                            android:textColor="#1A1A1A"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Periodo detectado por OCR — solo texto -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Periodo:  "
                            android:textSize="12sp"
                            android:textColor="#999999"/>

                        <TextView
                            android:id="@+id/txt_periodo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textColor="#1A1A1A"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Divisor -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EDE8DF"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"/>

                    <!-- Nombre profesor -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Profesor:  "
                            android:textSize="12sp"
                            android:textColor="#999999"/>

                        <TextView
                            android:id="@+id/txt_nombre_profesor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textSize="12sp"
                            android:textColor="#1A1A1A"
                            android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── CARD: MATERIAS DETECTADAS ─────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_materias_detectadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FEFCF8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Materias Detectadas"
                                android:textColor="#1A1A1A"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.01"/>

                            <TextView
                                android:id="@+id/texto_total_materias"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="5 materias encontradas"
                                android:textColor="@color/green_primary"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/btn_eliminar_horario"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/btn_eliminar_background"
                            android:contentDescription="Eliminar horario"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="@color/error"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EDE8DF"
                        android:layout_marginBottom="14dp"/>

                    <LinearLayout
                        android:id="@+id/container_materias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <Button
                        android:id="@+id/btn_agregar_materia"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="14dp"
                        android:backgroundTint="#F5F0EA"
                        android:text="+ Agregar Materia"
                        android:textColor="@color/green_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/green_primary"
                        app:strokeWidth="1dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_confirmar_materias"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/green_primary"
                            android:text="Confirmar"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp"/>

                        <Button
                            android:id="@+id/btn_escanear_nuevo"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#F5F0EA"
                            android:text="Escanear Nuevo"
                            android:textColor="#888888"
                            android:textSize="13sp"
                            app:cornerRadius="14dp"
                            app:strokeColor="#D4CEBE"
                            app:strokeWidth="1dp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── CARD: HORARIO SEMANAL ──────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_horario_semanal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FEFCF8"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_today"
                            android:layout_marginEnd="10dp"
                            app:tint="@color/green_primary"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Horario Semanal"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EDE8DF"/>

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabs_dias"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#FEFCF8"
                        app:tabMode="scrollable"
                        app:tabGravity="fill"
                        app:tabIndicatorColor="@color/green_primary"
                        app:tabIndicatorHeight="3dp"
                        app:tabSelectedTextColor="@color/green_primary"
                        app:tabTextColor="#AAAAAA"
                        app:tabRippleColor="@android:color/transparent"
                        app:tabTextAppearance="@android:style/TextAppearance.Small"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EDE8DF"/>

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewpager_dias"
                        android:layout_width="match_parent"
                        android:layout_height="480dp"
                        android:background="#FEFCF8"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- ── BOTTOM NAV ─────────────────────────────────────────────────── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FEFCF8"
        android:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu"/>

</RelativeLayout>