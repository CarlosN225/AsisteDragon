<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_degradado_login"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Espaciador Superior -->
        <View
            android:id="@+id/espaciador_superior"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_alignParentTop="true" />

        <!-- Tarjeta Blanca con Contenido -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/espaciador_superior"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
                android:gravity="center">

                <!-- Logo -->

                <!-- Saludo personalizado -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Bienvenido"
                    android:textColor="@color/green_primary"
                    android:textSize="35sp"
                    android:textStyle="bold" />

                <!-- Email del usuario -->
                <TextView
                    android:id="@+id/texto_email_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="usuario@utfv.edu.mx"
                    android:textSize="14sp"
                    android:textColor="@color/gray_medium"
                    android:layout_marginBottom="32dp"/>

                <!-- Instrucción -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:text="Ingrese su PIN"
                    android:textColor="@color/gray_medium"
                    android:textSize="26sp" />

                <!-- Puntos del PIN -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="48dp">

                    <View
                        android:id="@+id/punto_1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="12dp"
                        android:background="@drawable/punto_pin_vacio"/>

                    <View
                        android:id="@+id/punto_2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="12dp"
                        android:background="@drawable/punto_pin_vacio"/>

                    <View
                        android:id="@+id/punto_3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="12dp"
                        android:background="@drawable/punto_pin_vacio"/>

                    <View
                        android:id="@+id/punto_4"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="12dp"
                        android:background="@drawable/punto_pin_vacio"/>

                </LinearLayout>

                 <!-- Teclado Numérico -->
                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="4"
                    android:layout_marginBottom="16dp">

                    <!-- Fila 1: 1, 2, 3 -->
                    <Button
                        android:id="@+id/boton_1"
                        style="@style/EstiloBotonNumericoPIN"
                        android:background="@drawable/boton_numerico_pin"
                        android:text="1" />

                    <Button
                        android:id="@+id/boton_2"
                        style="@style/EstiloBotonNumericoPIN"
                        android:text="2"/>

                    <Button
                        android:id="@+id/boton_3"
                        style="@style/EstiloBotonNumericoPIN"
                        android:text="3"/>

                    <!-- Fila 2: 4, 5, 6 -->
                    <Button
                        android:id="@+id/boton_4"
                        style="@style/EstiloBotonNumericoPIN"
                        android:text="4"/>

                    <Button
                        android:id="@+id/boton_5"
                        style="@style/EstiloBotonNumericoPIN"
                        android:text="5"/>

                    <Button
                        android:id="@+id/boton_6"
                        style="@style/EstiloBotonNumericoPIN"
                        android:text="6"/>

                    <!-- Fila 3: 7, 8, 9 -->
                    <Button
                        android:id="@+id/boton_7"
                        style="@style/EstiloBotonNumericoPIN"
                        android:text="7"/>

                    <Button
                        android:id="@+id/boton_8"
                        style="@style/EstiloBotonNumericoPIN"
                        android:text="8"/>

                    <Button
                        android:id="@+id/boton_9"
                        style="@style/EstiloBotonNumericoPIN"
                        android:text="9"/>

                    <!-- Fila 4: 0 a la izquierda, Borrar ocupa 2 espacios -->
                    <Button
                        android:id="@+id/boton_0"
                        style="@style/EstiloBotonNumericoPIN"
                        android:text="0"/>

                    <Button
                        android:id="@+id/boton_borrar"
                        style="@style/EstiloBotonBorrarPIN"
                        android:background="@drawable/boton_numerico_pin"
                        android:text="⌫" />

                </GridLayout>


                <!-- Opción de usar contraseña -->
                <TextView
                    android:id="@+id/texto_usar_contrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usar contraseña en su lugar"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_primary"
                    android:padding="12dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </RelativeLayout>

</ScrollView>